option(
    'attestation_stub',
    type: 'boolean',
    description: 'Enables attestation stub',
    value: true,
)

option(
    'lldp_hosts_updater',
    type: 'boolean',
    description: 'Build lldp-hosts-updater: watches LLDP for peer IP and writes /etc/hosts',
    value: false,
)

option(
    'lldp_hosts_updater_iface',
    type: 'string',
    description: 'Network interface to watch for LLDP neighbours',
    value: 'eth2',
)

option(
    'pingtest',
    type: 'boolean',
    description: 'Enables pingtest tool',
    value: true,
)

option('tests', type: 'feature', description: 'Build unit tests', value: 'auto')

option(
    'use_pic_controller',
    type: 'boolean',
    description: 'Use I2CStrategy for persistence; default uses FileSystemStrategy',
    value: false,
)

option(
    'use_tpm_certificate',
    type: 'boolean',
    description: 'Use TPM-backed certificates and SSL contexts; default uses filesystem PEM files',
    value: false,
)
